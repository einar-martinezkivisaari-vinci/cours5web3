@server = http://localhost:3000
@auth = {{server}}/api/auth


### Add a new expense
POST {{auth}}/login
Content-Type: application/json

{
  "email":"john.doe@example.com",
  "password":"topsecret"
}

### Add a new expense without a category or participants
POST {{auth}}/register
Content-Type: application/json

{
  "name":"John Doe",
  "email":"john.doe@example.com",
  "password":"topsecret"
}